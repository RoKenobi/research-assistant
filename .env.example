# No Anthropic API key: LLM calls run through `claude -p` on your Claude plan.

# Optional — tracing. Self-hosted: http://<server-ip>:3000 (README → Self-hosting Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional — raises GitHub search limit from 10 to 30/min
GITHUB_TOKEN=
